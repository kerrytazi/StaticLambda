{
	"version": 3,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"STATIC_LAMBDA_EXAMPLE": "ON"
			}
		},

		{
			"name": "windows-base",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl.exe",
				"CMAKE_CXX_COMPILER": "cl.exe"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},

		{
			"name": "linux-base",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"vendor": {
				"microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
					"sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-debug",
			"displayName": "Debug Build",
			"configurePreset": "windows-base",
			"configuration": "Debug"
		},
		{
			"name": "windows-release",
			"displayName": "Release Build",
			"configurePreset": "windows-base",
			"configuration": "Release"
		},
		{
			"name": "linux-debug",
			"displayName": "Debug Build",
			"configurePreset": "linux-base",
			"configuration": "Debug"
		},
		{
			"name": "linux-release",
			"displayName": "Release Build",
			"configurePreset": "linux-base",
			"configuration": "Release"
		}
	]
}
